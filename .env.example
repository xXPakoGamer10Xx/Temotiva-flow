# ---------------------------------------------------------------------------
# Temotiva Flow V1 — variables de entorno
# Copia este archivo como `.env.local`. NUNCA comitees `.env.local`.
# ---------------------------------------------------------------------------

# Secreto de firma de sesion (obligatorio). Genera uno con: npx auth secret
AUTH_SECRET=

# Google OAuth 2.0 (Google Cloud Console > Credenciales > ID de cliente OAuth)
# Origen autorizado:        http://localhost:3000
# URI de redireccion:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Acceso de desarrollo (SOLO local)
# Habilita el proveedor de credenciales de desarrollo con los perfiles semilla.
# Solo surte efecto si ademas NODE_ENV === 'development'. En produccion se
# ignora siempre. Dejalo sin definir o en `false` en cuanto tengas Google OAuth.
# ---------------------------------------------------------------------------
ALLOW_DEV_AUTH=true

# ---------------------------------------------------------------------------
# Capa de datos
# Persiste el estado en memoria como snapshot JSON en ./.data para que las
# demos sobrevivan a reinicios del servidor. `false` = memoria volatil pura.
# ---------------------------------------------------------------------------
DATA_SNAPSHOT=true
